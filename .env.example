# Server-side only. Never expose this as a VITE_* variable.
GEMINI_API_KEY=

# Optional public URL of a separately deployed server-side proxy for static hosting.
VITE_AI_API_URL=

# Optional: restrict a separately deployed backend to this public frontend origin.
AI_ALLOWED_ORIGIN=https://zimmxx.github.io

# Private datasets are never exposed through VITE_* variables. The local API keeps
# access-control data under the ignored private/ directory. Production should use
# institutional SSO and server-side secrets as described in docs/PRIVATE_LIBRARY_SECURITY.md.
